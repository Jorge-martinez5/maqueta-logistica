---
import Layout from '../layouts/Layout.astro';
import Maqueta from '../components/Maqueta.astro';
import { negocio, servicios, proyectos, equipo, navegacion, productos } from '../data/negocio';
---
<Layout>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#inicio" aria-label="Tisnova, inicio">
        <img src={negocio.logo} alt="Tisnova" width="132" height="25" />
      </a>
      <nav class="site-nav" aria-label="Navegación principal">
        {navegacion.map(({ nombre, href }) => <a href={href}>{nombre}</a>)}
      </nav>
      <a class="header-cta" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav">
        <summary>Menú</summary>
        <nav aria-label="Navegación móvil">
          {navegacion.map(({ nombre, href }) => <a href={href}>{nombre}</a>)}
        </nav>
      </details>
    </div>
  </header>

  <main id="contenido">
    <Maqueta />

    <section class="section catalogo" id="productos" aria-labelledby="productos-titulo">
      <div class="wrap chapter">
        <h2 id="productos-titulo">Conoced cada <em>aplicación.</em></h2>
        <p class="section-intro">Explorad el recorrido y consultad las funciones de cada producto.</p>
        <div class="catalogo-lista">
          {productos.map((producto) => {
            const visitas = { tistms: 'tms', tissga: 'interior', tistransit: 'transit', tistime: 'time', tisrural: 'rural', tisgame: 'game' };
            return <article>
              <h3><img src={`/productos/${producto.id}.svg`} width="26" height="26" alt="" loading="lazy" />{producto.nombre}</h3>
              <p>{producto.descripcion}</p>
              <div class="catalogo-acciones">
                <a class="text-link" href="#aplicaciones" data-visita-destino={visitas[producto.id]}>Ver recorrido</a>
                <a class="text-link" href={producto.url}>Funciones de {producto.nombre} <span aria-hidden="true">↗</span></a>
              </div>
            </article>;
          })}
        </div>
      </div>
    </section>

    <section class="section projects" id="proyectos" aria-labelledby="projects-title">
      <div class="wrap chapter">
        <p class="eyebrow">Proyectos y colaboraciones</p>
        <h2 id="projects-title" data-reveal>Conexiones <em>en marcha.</em></h2>
        <div class="project-list">
          {proyectos.map(({ categoria, nombre, descripcion, url }) => (
            <a class="project-link" href={url}>
              <p class="eyebrow">{categoria}</p>
              <h3>{nombre} <span aria-hidden="true">↗</span></h3><p>{descripcion}</p>
            </a>
          ))}
        </div>
        <a class="text-link proyecto-caso" href="https://chamartin.tisnova.es/">Ver el campeonato de Chamartín <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="section team" id="equipo" aria-labelledby="team-title">
      <div class="wrap chapter">
        <p class="eyebrow">Equipo</p>
        <h2 id="team-title" data-reveal>Hablemos con{' '}<br /><em>nombres propios.</em></h2>
        <p class="section-intro">Trabajamos juntos en consultoría, desarrollo y sistemas desde Molina de Segura.</p>
        <div class="team-grid">
          {equipo.map(({ nombre, foto, width, height }) => (
            <figure><img src={foto} width={width} height={height} alt={`Retrato de ${nombre}`} loading="lazy" /><figcaption>{nombre}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section servicios-empresa" id="servicios" aria-labelledby="servicios-titulo">
      <div class="wrap chapter">
        <p class="eyebrow">Servicios</p>
        <h2 id="servicios-titulo">Vuestro equipo <em>tecnológico.</em></h2>
        <p class="section-intro">Empezamos por cómo trabajáis y vemos juntos qué conviene resolver primero.</p>
        <ul class="servicios-lista">
          {servicios.map(({ nombre, descripcion, url }) => (
            <li>
              <a href={url}>
                <h3>{nombre} <span aria-hidden="true">↗</span></h3>
                <p>{descripcion}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section contact" id="contacto" aria-labelledby="contact-title">
      <div class="wrap chapter">
        <p class="eyebrow">Contacto</p>
        <h2 id="contact-title" data-reveal>Contadnos{' '}<br /><em>vuestro caso.</em></h2>
        <p class="section-intro">¿Qué tarea os gustaría simplificar? Empecemos por cómo la hacéis hoy.</p>
        <a class="button" href={negocio.contacto}>Abrir formulario <span aria-hidden="true">↗</span></a>
        <address>
          <a href={`mailto:${negocio.email}`}>{negocio.email} <span aria-hidden="true">↗</span></a>
          <a href={negocio.telefonoHref}>{negocio.telefono} <span aria-hidden="true">↗</span></a>
          <a href={negocio.mapa}>{negocio.ubicacion} <span aria-hidden="true">↗</span></a>
        </address>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a href="#inicio" class="brand"><img src={negocio.logo} alt="Tisnova" width="104" height="20" /></a>
      <p>© {new Date().getFullYear()} {negocio.nombre}</p>
      <div><a href={negocio.privacidad}>Privacidad</a><a href={negocio.legal}>Aviso legal</a><a href="https://tisnova.es/politica-de-cookies">Cookies</a><button type="button" data-motion-toggle aria-pressed="false">Pausar animaciones</button></div>
    </div>
  </footer>
</Layout>

<script>
  import '../scripts/web';
</script>

<style>
  [data-motion-toggle] { cursor: pointer; color: inherit; font: inherit; background: transparent; border: 1px solid #bbcfb9; border-radius: 8px; padding: 6px 10px; }
  .catalogo { background: #182b22; color: #f2f3e7; }
  .catalogo h2 em { color: #cbd8a5; }
  .catalogo .section-intro { color: #bdc9bb; }
  .catalogo .text-link { color: #d6e2b7; text-decoration-color: #6b865f; }

  .catalogo-lista { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 48px 32px; max-width: 1200px; margin: 54px auto 0; text-align: left; }
  .catalogo-lista article { padding: 0 0 26px; border-bottom: 1px solid #47604b; }
  .catalogo-lista h3 { display: flex; align-items: center; gap: 10px; font-size: 1.3rem; }
  .catalogo-lista p { margin-top: 12px; max-width: 65ch; color: #bdc9bb; line-height: 1.6; }
  @media(max-width:720px) { .catalogo-lista { grid-template-columns: 1fr; gap: 36px; } }
  .catalogo-acciones { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 16px; }

  .section .chapter { width: min(100% - 2 * var(--gutter),1200px); }
  .section h2 { font-size: clamp(48px,6vw,88px); letter-spacing: -.045em; }
  .projects { background: #eceee3; }
  .projects .project-list { max-width: none; gap: 42px; text-align: left; margin-top: 56px; }
  .projects .project-link { background: transparent; padding: 28px 0; }
  .projects .project-link h3 { font-size: clamp(24px,2.5vw,36px); line-height: 1.15; margin-block: 14px; }
  .team { background: #f9f8f1; }
  .team-grid { max-width: none; gap: 24px; margin-top: 52px; }
  .team-grid img { aspect-ratio: 4/5; object-fit: cover; border-radius: 3px; }
  .team-grid figcaption { text-align: left; font-size: 16px; margin-top: 16px; }
  .contact { background: #223a2d; color: #f0f2df; }
  .contact h2 em { color: #d9e3b7; }
  .contact .eyebrow, .contact .section-intro { color: #c4d0bc; }
  .contact .button { color: #203726; background: #e0e9bf; padding-inline: 24px; }
  .contact address a { background: transparent; color: #dfe9cf; }
  @media(max-width:720px) {
    .projects .project-list { grid-template-columns: 1fr; gap: 10px; }
    .team-grid { gap: 24px 14px; }
  }
  .proyecto-caso { margin-top: 22px; }
  .servicios-empresa { background: #f0f5ec; }
  .servicios-lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    max-width: 740px;
    margin: 32px auto 0;
    text-align: left;
  }
  .servicios-lista a {
    display: block;
    height: 100%;
    padding: 17px 4px 20px;
    border-top: 1px solid #bbcfb9;
  }
  .servicios-lista h3 { color: var(--color-ink); font-size: 1.08rem; font-weight: 680; }
  .servicios-lista a:hover h3 { color: var(--color-accent); }
  .servicios-lista h3 span { margin-left: 4px; color: var(--color-accent); font-size: .75em; }
  .servicios-lista p { margin-top: 5px; color: var(--muted); font-size: .9rem; line-height: 1.5; }

  @media (max-width: 540px) {
    .servicios-lista { grid-template-columns: 1fr; margin-top: 24px; }
  }
</style>
