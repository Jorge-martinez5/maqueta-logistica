---
import Layout from '../layouts/Layout.astro';
import Maqueta from '../components/Maqueta.astro';
import { negocio, servicios, productos, proyectos, equipo, navegacion } from '../data/negocio';
const otrasApps = productos.filter(({ id }) => !['tistms', 'tistransit', 'tissga'].includes(id));
---
<Layout>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="#inicio" aria-label="Tisnova, inicio">
        <img src={negocio.logo} alt="Tisnova" width="132" height="25" />
      </a>
      <nav class="site-nav" aria-label="Navegación principal">
        {navegacion.map(({ nombre, href }) => <a href={href}>{nombre}</a>)}
      </nav>
      <a class="header-cta" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav">
        <summary>Menú</summary>
        <nav aria-label="Navegación móvil">
          {navegacion.map(({ nombre, href }) => <a href={href}>{nombre}</a>)}
        </nav>
      </details>
    </div>
  </header>

  <main id="contenido">
    <Maqueta />

    <section class="section services" id="servicios" aria-labelledby="services-title">
      <div class="wrap chapter">
        <p class="eyebrow">Servicios</p>
        <h2 id="services-title" data-reveal>Vuestro equipo{' '}<br /><em>tecnológico.</em></h2>
        <p class="section-intro">Empezamos por cómo trabajáis y vemos juntos qué conviene resolver primero.</p>
        <div class="service-list">
          {servicios.map(({ nombre, descripcion, url }) => (
            <a class="service-link" href={url}>
              <h3>{nombre} <span aria-hidden="true">↗</span></h3><p>{descripcion}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section catalogo" aria-labelledby="catalogo-title">
      <div class="wrap chapter">
        <p class="eyebrow">Más software propio</p>
        <h2 id="catalogo-title" data-reveal>También fuera{' '}<br /><em>de la terminal.</em></h2>
        <div class="catalogo-list">
          {otrasApps.map(({ id, nombre, sector, url }) => (
            <a href={url} class="catalogo-link">
              <img src={`/productos/${id}.svg`} width="34" height="34" alt="" loading="lazy" />
              <strong>{nombre}</strong><span>{sector}</span>
            </a>
          ))}
        </div>
        <a class="text-link" href="https://chamartin.tisnova.es/">Ver el campeonato de Chamartín <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="section projects" id="proyectos" aria-labelledby="projects-title">
      <div class="wrap chapter">
        <p class="eyebrow">Proyectos y colaboraciones</p>
        <h2 id="projects-title" data-reveal>Conexiones <em>en marcha.</em></h2>
        <div class="project-list">
          {proyectos.map(({ categoria, nombre, descripcion, url }) => (
            <a class="project-link" href={url}>
              <p class="eyebrow">{categoria}</p>
              <h3>{nombre} <span aria-hidden="true">↗</span></h3><p>{descripcion}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section team" id="equipo" aria-labelledby="team-title">
      <div class="wrap chapter">
        <p class="eyebrow">Equipo</p>
        <h2 id="team-title" data-reveal>Hablemos con{' '}<br /><em>nombres propios.</em></h2>
        <p class="section-intro">Trabajamos juntos en consultoría, desarrollo y sistemas desde Molina de Segura.</p>
        <div class="team-grid">
          {equipo.map(({ nombre, foto, width, height }) => (
            <figure><img src={foto} width={width} height={height} alt={`Retrato de ${nombre}`} loading="lazy" /><figcaption>{nombre}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section contact" id="contacto" aria-labelledby="contact-title">
      <div class="wrap chapter">
        <p class="eyebrow">Contacto</p>
        <h2 id="contact-title" data-reveal>Contadnos{' '}<br /><em>vuestro caso.</em></h2>
        <p class="section-intro">¿Qué tarea os gustaría simplificar? Empecemos por cómo la hacéis hoy.</p>
        <a class="button" href={negocio.contacto}>Abrir formulario <span aria-hidden="true">↗</span></a>
        <address>
          <a href={`mailto:${negocio.email}`}>{negocio.email} <span aria-hidden="true">↗</span></a>
          <a href={negocio.telefonoHref}>{negocio.telefono} <span aria-hidden="true">↗</span></a>
          <a href={negocio.mapa}>{negocio.ubicacion} <span aria-hidden="true">↗</span></a>
        </address>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a href="#inicio" class="brand"><img src={negocio.logo} alt="Tisnova" width="104" height="20" /></a>
      <p>© {new Date().getFullYear()} {negocio.nombre}</p>
      <div><a href={negocio.privacidad}>Privacidad</a><a href={negocio.legal}>Aviso legal</a></div>
    </div>
  </footer>
</Layout>

<script>
  import '../scripts/web';
</script>
