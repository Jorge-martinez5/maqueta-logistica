---
import Escenario from './Escenario.astro';
import { productos } from '../data/negocio';

const paradas = [
  {
    id: 'tistms', foto: '/maqueta/transporte.webp',
    titulo: 'Del pedido al viaje.',
    texto: 'Agrupad las cargas, asignad vehículos y organizad los viajes. TisTms comparte información con Business Central para que tráfico y administración trabajen sobre los mismos datos.',
  },
  {
    id: 'tistransit', foto: '/maqueta/control.webp',
    titulo: 'Documentos en ruta.',
    texto: 'Preparad y compartid el DeCA y la hoja de ruta electrónica. El equipo de oficina y quien conduce pueden consultar los documentos del mismo servicio.',
  },
  {
    id: 'tissga', foto: '/maqueta/almacen.webp',
    titulo: 'Seguid cada palé.',
    texto: 'Registrad la entrada de la mercancía, asignadle una ubicación y seguid sus movimientos hasta la salida. TisSGA reúne esos datos para preparar la prefacturación.',
  },
].map((parada) => ({ ...parada, producto: productos.find(({ id }) => id === parada.id)! }));
---
<Escenario etiqueta="Recorrido por el software logístico de Tisnova"
  paradas={paradas.map(({ id, producto }) => ({ id, nombre: producto.nombre }))}>
    <div class="maqueta-tramo" data-escena="inicio">
      <img class="maqueta-foto" src="/maqueta/portada.webp" width="1440" height="823" alt="" fetchpriority="high" />
      <div class="maqueta-copy">
        <p class="eyebrow" data-enter>Consultoría y software · Murcia</p>
        <h1 data-enter>La logística,{' '}<br /><em>conectada.</em></h1>
        <p data-enter>Un pedido sale de tráfico, pasa por el control documental y llega al almacén. Descubrid cómo Tisnova conecta cada paso.</p>
        <a class="button" href="#tistms" data-enter>Empezar el recorrido <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    {paradas.map(({ id, titulo, texto, foto, producto }) => (
      <article class="maqueta-tramo" id={id} data-escena={id} aria-labelledby={`titulo-${id}`}>
        <img class="maqueta-foto" src={foto} width="1440" height="823" alt="" loading="lazy" />
        <div class="maqueta-copy">
          <p class="maqueta-producto">
            <img src={`/productos/${id}.svg`} width="28" height="28" alt="" loading="lazy" />
            <strong>{producto.nombre}</strong><span>{producto.sector}</span>
          </p>
          <h2 id={`titulo-${id}`}>{titulo}</h2>
          <p>{texto}</p>
          <a class="text-link" href={id === 'tissga' ? '/sga' : producto.url}>Conocer {producto.nombre} <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
</Escenario>
